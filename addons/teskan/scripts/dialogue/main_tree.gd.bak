tool
extends Tree

var tree = self
var root = tree.create_item()

var characters_tree_holder = tree.create_item(root)
var themes_tree_holder = tree.create_item(root)
var timelines_tree_holder = tree.create_item(root)
var variables_tree_holder = tree.create_item(root)

var files = {
	"characters":[],
	"themes":[],
	"timelines":[],
	"variables":[]	
}

var dirs = {
	'characters' : Directory.new(),
	'themes' : Directory.new(),
	'timelines' : Directory.new(),
	'variables' : Directory.new(),
}

func _ready():
	tree.set_hide_root(true)
	
	characters_tree_holder.set_text(0, "Characters")
	themes_tree_holder.set_text(0, "Themes")
	timelines_tree_holder.set_text(0, "Timelines")
	variables_tree_holder.set_text(0, "Variables")
	
	#characters.open("res://addons/teskan/data/dialogue/characters/")
	#themes.open("res://addons/teskan/data/dialogue/themes/")
	#timelines.open("res://addons/teskan/data/dialogue/timelines/")
	#variables.open("res://addons/teskan/data/dialogue/variables/")
	get_files(dirs['characters'],'characters',files)
	get_files(dirs['themes'],'themes',files)
	get_files(dirs['timelines'],'timelines',files)
	get_files(dirs['variables'],'variables',files)
	
	var file = File.new()
	
	#print(load("res://addons/teskan/data/dialogue/characters/"+files['characters'][0]).name)
	
	var i = 0
	while true:
		#var index = files['characters'].append()
		
		if i > files['characters'].size():
			break
		elif files['characters'].size() > 1:
			#print(files['characters'].size())
			add_tree_item(characters_tree_holder,files['characters'][i])
			i += 1
	
func add_tree_item(tree_holder,metadata):
	var new_tree_child = tree.create_item(tree_holder)
	new_tree_child.set_text(0,load("res://addons/teskan/data/dialogue/characters/"+metadata).name)
	new_tree_child.set_icon(0,load("res://addons/teskan/sprites/character.png"))
	new_tree_child.set_metadata(0,metadata)
	
	#print(new_tree_child.get_metadata(0))

func get_files(dir,string,files):
	dir.open("res://addons/teskan/data/dialogue/"+string)
	#print(string)
	dir.list_dir_begin()
	
	while true:
		var file = dir.get_next()
		if file == "":
			break
		elif not file.begins_with("."):
			files[string].append(file)
			
	#print(files)
	dir.list_dir_end()
